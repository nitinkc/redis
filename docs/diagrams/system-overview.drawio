<mxfile host="Electron">
  <diagram id="system-overview" name="System overview">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;you are here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b&gt;frontend/&lt;/b&gt;&lt;br&gt;React + nginx&lt;br&gt;serves UI, proxies /api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="240" y="170" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="be" value="&lt;b&gt;backend/&lt;/b&gt;&lt;br&gt;Express (stateless)&lt;br&gt;/health /ready /api/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="460" y="170" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;the only state&lt;br&gt;(in-memory, no volume)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="690" y="165" width="110" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value=":3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="browser" target="ui">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="/api/* :8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="ui" target="be">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="GET/SET/DEL :6379" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="be" target="redis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="Stateless: replicas can multiply freely" style="text;html=1;align=center;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="450" y="260" width="180" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="Single point of failure — restarts lose data" style="text;html=1;align=center;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="650" y="265" width="200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="docs" value="&lt;b&gt;docs/&lt;/b&gt;&lt;br&gt;MkDocs site :8000&lt;br&gt;Swagger UI talks to :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="Try it out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="docs" target="be">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
