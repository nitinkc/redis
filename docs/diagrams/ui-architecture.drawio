<mxfile host="Electron">
  <diagram id="ui-architecture" name="UI architecture">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="dev" value="DEV: vite :3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="prod" value="PROD: nginx :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontStyle=italic;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="360" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="src/App.jsx&lt;br&gt;polls /api/info + /api/kv every 5s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="viteproxy" value="vite.config.js proxy&lt;br&gt;/api → localhost:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="160" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="static" value="nginx serves dist/&lt;br&gt;GET /healthz → 200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ngxproxy" value="default.conf.template&lt;br&gt;/api/ → ${BACKEND_URL} (envsubst at start)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="350" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="be" value="backend :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="200" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="app" target="viteproxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="viteproxy" target="be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="static" target="ngxproxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ngxproxy" target="be"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="One image, all regions — BACKEND_URL injected at container start, no rebuild" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="640" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
